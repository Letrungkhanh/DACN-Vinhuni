@model Do_an.Models.TbAccount

@{
    ViewData["Title"] = "Thông tin tài khoản";
}
@if (Model != null)
{
   

        <div class="container my-5">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="card border-0 shadow">
                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                            <h4 class="mb-0"><i class="bi bi-person-circle me-2"></i>Thông tin tài khoản</h4>
                            
                        </div>
                        <div class="card-body">

                            <div class="mb-4">
                                <label class="form-label fw-semibold">👤 Họ và tên:</label>
                                <div class="form-control bg-light">@Model.Username</div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold">📧 Email:</label>
                                <div class="form-control bg-light">@Model.Email</div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold">📞 Số điện thoại:</label>
                                <div class="form-control bg-light">@Model.Phone</div>
                            </div>

                            <!-- Có thể thêm các trường khác tại đây -->
                                <a asp-action="Edit" asp-controller="UserProfile" class="btn btn-light btn-sm">
                                    <i class="bi bi-pencil-square"></i> Đổi mật khẩu
                                </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
}
else
{
        <div class="alert alert-danger text-center my-5" role="alert">
            Không thể tải thông tin tài khoản. Vui lòng thử lại sau!
        </div>
}


