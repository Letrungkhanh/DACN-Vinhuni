@model List<Do_an.Models.TbOrder>
@{
    ViewData["Title"] = "Lịch sử đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Sửa theo layout bạn dùng
}
<h2 class="mb-4 fw-bold text-primary"><i class="bi bi-receipt-cutoff me-2"></i>Lịch sử đơn hàng</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">
        @TempData["Message"]
    </div>
}

@if (!Model.Any())
{
        <div class="alert alert-warning d-flex align-items-center" role="alert">
            <i class="bi bi-info-circle-fill me-2"></i>
            <div>Bạn chưa có đơn hàng nào.</div>
        </div>
}
else
{
    foreach (var order in Model)
    { 
                <div class="card mb-4 shadow-sm border-0">
                    <div class="card-header bg-primary text-white d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                        <div>
                            <h5 class="mb-1">
                                <i class="bi bi-bag-check-fill me-1"></i>Đơn hàng #@order.OrderId - 
                                <span class="fw-normal">Mã: @order.Code</span>
                            </h5>
                            <small>
                                <i class="bi bi-calendar-date me-1"></i>Ngày đặt: 
                                <strong>@order.CreatedDate?.ToString("dd/MM/yyyy")</strong>
                            </small>
                        </div>
                        <div class="text-md-end mt-2 mt-md-0">
                            <span class="fw-bold">Tổng tiền: </span>
                            <span class="fs-5 text-warning">@String.Format("{0:N0} VNĐ", order.TotalAmount)</span>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-hover table-bordered mb-0">
                            <thead class="table-light text-center">
                                <tr>
                                    <th scope="col"><i class="bi bi-box-seam me-1"></i>Sản phẩm</th>
                                    <th scope="col">Số lượng</th>
                                    <th scope="col">Đơn giá</th>
                                    <th scope="col">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                        @foreach (var item in order.TbOrderDetails)
                        {
                                        <tr>
                                            <td>@item.Product?.Title</td>
                                            <td class="text-center">@item.Quantity</td>
                                            <td class="text-end">@String.Format("{0:N0} VNĐ", item.Price)</td>
                                            <td class="text-end text-success fw-semibold">@String.Format("{0:N0} VNĐ", item.Quantity * item.Price)</td>
                                        </tr>
                        }
                            </tbody>
                        </table>
                    </div>
            @if (order.OrderStatusId != 5) // Nếu chưa huỷ thì mới hiển thị nút
            {
                <form asp-action="CancelOrder" asp-controller="OrderHistory" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn huỷ đơn hàng này không?');">
                    <input type="hidden" name="id" value="@order.OrderId" />
                    <button type="submit" class="btn btn-danger btn-sm mt-2">
                        <i class="bi bi-x-circle"></i> Huỷ đơn hàng
                    </button>
                </form>
            }
            else
            {
                <div class="alert alert-danger fw-bold text-center fs-5 mt-3" role="alert">
                    🚫 Đơn hàng đã bị huỷ
                </div>
            }



                </div>
    }
}
